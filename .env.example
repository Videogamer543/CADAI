# Copy to .env and fill in. NEVER commit .env to source control.
# Rotate any key you have ever pasted into a chat or shared.

# AI assistant (server-side only — never sent to the browser)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=your_tavily_key_here

# Onshape — DEV/personal use only (read-documents scope key).
# Every request made with these reads YOUR documents under YOUR name, which is
# fine on your own machine and unacceptable once anyone else can open the app.
# For a PUBLIC app use the OAuth block below instead (app/onshape_oauth.py).
ONSHAPE_ACCESS_KEY=your_onshape_access_key
ONSHAPE_SECRET_KEY=your_onshape_secret_key

# Onshape OAuth — the correct choice for anything public. Each visitor
# authorises their own account, so there is no shared credential to leak.
# Create the application in the Onshape developer portal with ONLY
# "Application can read your documents" ticked.
#
# The redirect must match a registered Redirect URL character for character,
# including scheme, port and trailing slash. Register both of these on the
# Onshape application and set this to whichever one this server answers on:
#   local   http://localhost:8000/api/onshape/callback
#   Space   https://<user>-stressviz.hf.space/api/onshape/callback
# ONSHAPE_OAUTH_CLIENT_ID=on_...
# ONSHAPE_OAUTH_CLIENT_SECRET=
# ONSHAPE_OAUTH_REDIRECT=http://localhost:8000/api/onshape/callback
#
# Almost always left unset. Onshape takes an application's permissions from the
# boxes ticked at creation rather than from a scope parameter, and both of its
# own reference integrations send none. Present only so a change on their side
# would not need a code change.
# ONSHAPE_OAUTH_SCOPE=


# ---------------------------------------------------------------------------
# Going public.  Leave every one of these unset on your own machine.
# See GOING_PUBLIC.md.  Enforced by app/limits.py.
# ---------------------------------------------------------------------------

# The master switch. Turns on sensible defaults for every limit below at once.
# Without it StressViz has no rate limits at all, which is correct for a tool
# only you can reach and ruinous for one anybody can.
# STRESSVIZ_PUBLIC=1

# A shared password (HTTP Basic). By far the cheapest protection there is: an
# address nobody can use is an address nobody can run your API bill up on.
# Only meaningful over HTTPS — Basic sends the password in near-plain text.
# STRESSVIZ_USERNAME=stressviz
# STRESSVIZ_PASSWORD=

# Biggest upload accepted, megabytes. A STEP of a single plate is well under 1.
# STRESSVIZ_MAX_UPLOAD_MB=12

# Chat, per visitor. Each question is one Groq call plus up to four Tavily
# searches, so these are the numbers that spend money.
# STRESSVIZ_CHAT_PER_MIN=8
# STRESSVIZ_CHAT_PER_HOUR=60

# Chat, everyone added together, per UTC day. The backstop the per-visitor
# limits cannot be: a hundred people asking politely still costs a hundred
# people's worth of searches. Set this to what you are willing to pay.
# STRESSVIZ_CHAT_PER_DAY=400

# Analyses per visitor, and how many may run at once across the whole server.
# A 3D solve is tens of seconds of CPU; two at a time is a busy machine.
# STRESSVIZ_SOLVE_PER_MIN=6
# STRESSVIZ_SOLVE_PER_HOUR=60
# STRESSVIZ_SOLVE_CONCURRENT=2

# Analyses, everyone added together, per UTC day. Same backstop argument as
# CHAT_PER_DAY, for a different bill: chat costs Groq and Tavily money, solves
# cost whoever is hosting.
# STRESSVIZ_SOLVE_PER_DAY=200

# The one that maps to a hosting bill directly: seconds of solving, everyone
# added together, per UTC day. Counting solves is a proxy, because a plate
# outline is two seconds and a tetrahedral mesh is ninety. Cloud Run's free
# tier is 180,000 vCPU-seconds a month, so an hour a day is roughly 111,000 a
# month at one vCPU, with headroom for chat and cold starts. Charged after each
# solve finishes, so it can be overrun by at most one analysis.
# STRESSVIZ_COMPUTE_SECONDS_PER_DAY=3600

# Only set this when StressViz genuinely sits behind a proxy you control
# (Cloudflare, nginx, a PaaS router). It makes the per-visitor limits trust the
# X-Forwarded-For header — which anyone can send, so with no proxy in front it
# hands every visitor an unlimited supply of fresh identities.
# STRESSVIZ_TRUST_PROXY=1
